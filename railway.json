{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "bin/railway-build.sh"
  },
  "deploy": {
    "startCommand": "bundle exec rails db:migrate && bundle exec puma -C config/puma.rb",
    "healthcheckPath": "/up",
    "healthcheckTimeout": 30
  }
}
