<%# Priority Queue Widget — Top 5 high-priority tasks across all boards %>
<div class="bg-bg-surface border border-border rounded-lg">
  <div class="flex items-center justify-between px-4 py-3 border-b border-border">
    <h2 class="text-sm font-semibold text-content font-display">Priority Queue</h2>
    <span class="text-xs text-content-muted">Top 5</span>
  </div>

  <div class="p-4">
    <% if @priority_tasks.any? %>
      <ul class="flex flex-col gap-2.5">
        <% @priority_tasks.each_with_index do |task, index| %>
          <li class="flex items-start gap-3 group">
            <%# Rank number %>
            <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center rounded text-[10px] font-bold bg-bg-elevated text-content-muted">
              <%= index + 1 %>
            </span>

            <%# Priority flames %>
            <div class="flex-shrink-0 mt-0.5">
              <% flame_count = task.priority == "high" ? 3 : 2 %>
              <% flame_color = task.priority == "high" ? "text-accent" : "text-orange-500" %>
              <div class="flex -space-x-1">
                <% flame_count.times do |i| %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 <%= flame_color %>" style="position: relative; z-index: <%= flame_count - i %>;">
                    <path fill-rule="evenodd" d="M12.963 2.286a.75.75 0 0 0-1.071-.136 9.742 9.742 0 0 0-3.539 6.176 7.547 7.547 0 0 1-1.705-1.715.75.75 0 0 0-1.152-.082A9 9 0 1 0 15.68 4.534a7.46 7.46 0 0 1-2.717-2.248ZM15.75 14.25a3.75 3.75 0 1 1-7.313-1.172c.628.465 1.35.81 2.133 1a5.99 5.99 0 0 1 1.925-3.546 3.75 3.75 0 0 1 3.255 3.718Z" clip-rule="evenodd" />
                  </svg>
                <% end %>
              </div>
            </div>

            <%# Task info %>
            <div class="flex-1 min-w-0">
              <% board = task.board %>
              <%= link_to board_task_path(board, task),
                          data: { turbo_frame: "_top" },
                          class: "text-sm text-content-secondary group-hover:text-content transition-colors truncate block" do %>
                <%= task.name %>
              <% end %>
              <div class="flex items-center gap-2 mt-0.5">
                <span class="text-[10px] text-content-muted"><%= task.board.icon %> <%= task.board.name %></span>
                <% if task.assigned_to_agent? %>
                  <span class="text-[10px]"><%= current_user.agent_emoji || "🦞" %></span>
                <% end %>
                <% if task.status == "in_progress" %>
                  <span class="text-[10px] text-status-info">In Progress</span>
                <% end %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="text-center py-6">
        <p class="text-sm text-content-muted">No high-priority tasks</p>
        <p class="text-xs text-content-muted/60 mt-1">Set task priority to medium or high to see them here</p>
      </div>
    <% end %>
  </div>
</div>
