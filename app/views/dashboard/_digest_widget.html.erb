<%# Overnight Digest Widget — Shows latest content entries %>
<div class="glass-card rounded-2xl hover-lift">
  <div class="flex items-center justify-between px-5 py-4 border-b border-white/5">
    <h2 class="text-sm font-semibold text-content font-display tracking-tight">Overnight Digest</h2>
    <% if @digest_contents.present? && @digest_contents.any? %>
      <%= link_to "View all", contents_path, class: "text-[11px] font-medium text-accent hover:text-accent-hover transition-colors duration-200" %>
    <% else %>
      <span class="text-[11px] text-content-muted font-medium tracking-wide uppercase">Latest</span>
    <% end %>
  </div>

  <div class="p-5">
    <% if @digest_contents.present? && @digest_contents.any? %>
      <div class="space-y-3.5">
        <% @digest_contents.each do |content| %>
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-9 h-9 rounded-xl bg-white/5 flex items-center justify-center text-sm">
              <%= platform_emoji(content.platform) %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-[10px] px-2 py-0.5 rounded-md font-medium
                  <%= case content.status
                      when 'idea' then 'bg-purple-500/10 text-purple-400'
                      when 'draft' then 'bg-yellow-500/10 text-yellow-500'
                      when 'review' then 'bg-blue-500/10 text-blue-500'
                      when 'approved' then 'bg-green-500/10 text-green-500'
                      when 'scheduled' then 'bg-blue-500/10 text-blue-400'
                      when 'published' then 'bg-green-500/10 text-green-400'
                      else 'bg-white/5 text-content-muted'
                      end %>">
                  <%= content.status.capitalize %>
                </span>
                <span class="text-[10px] text-content-muted"><%= time_ago_in_words(content.created_at) %> ago</span>
              </div>
              <p class="text-[13px] text-content truncate mt-1"><%= content.title %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6 text-content-muted/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
          </svg>
        </div>
        <p class="text-sm text-content-muted font-medium">No digest data yet</p>
        <p class="text-xs text-content-muted/50 mt-1.5 max-w-[240px] mx-auto leading-relaxed">Overnight content and research output will appear here once the Content Studio is active</p>
      </div>
    <% end %>
  </div>
</div>
