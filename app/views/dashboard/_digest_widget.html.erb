<%# Overnight Digest Widget — Shows latest content entries %>
<div class="bg-bg-surface border border-border rounded-lg">
  <div class="flex items-center justify-between px-4 py-3 border-b border-border">
    <h2 class="text-sm font-semibold text-content font-display">Overnight Digest</h2>
    <% if @digest_contents.present? && @digest_contents.any? %>
      <%= link_to "View all", contents_path, class: "text-xs text-accent hover:text-accent-hover transition-colors" %>
    <% else %>
      <span class="text-xs text-content-muted">Latest</span>
    <% end %>
  </div>

  <div class="p-4">
    <% if @digest_contents.present? && @digest_contents.any? %>
      <div class="space-y-3">
        <% @digest_contents.each do |content| %>
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-bg-elevated flex items-center justify-center text-sm">
              <%= platform_emoji(content.platform) %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-xs px-1.5 py-0.5 rounded font-medium
                  <%= case content.status
                      when 'idea' then 'bg-purple-500/10 text-purple-400'
                      when 'draft' then 'bg-yellow-500/10 text-yellow-500'
                      when 'review' then 'bg-blue-500/10 text-blue-500'
                      when 'approved' then 'bg-green-500/10 text-green-500'
                      when 'scheduled' then 'bg-blue-500/10 text-blue-400'
                      when 'published' then 'bg-green-500/10 text-green-400'
                      else 'bg-bg-elevated text-content-muted'
                      end %>">
                  <%= content.status.capitalize %>
                </span>
                <span class="text-xs text-content-muted"><%= time_ago_in_words(content.created_at) %> ago</span>
              </div>
              <p class="text-sm text-content truncate mt-0.5"><%= content.title %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-6">
        <div class="w-10 h-10 rounded-lg bg-bg-elevated flex items-center justify-center mx-auto mb-3">
          <svg class="w-5 h-5 text-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
          </svg>
        </div>
        <p class="text-sm text-content-muted">No digest data yet</p>
        <p class="text-xs text-content-muted/60 mt-1">Overnight content and research output will appear here once the Content Studio is active</p>
      </div>
    <% end %>
  </div>
</div>
