<%# Agent Status Widget — Is the agent online? Last activity? %>
<div class="glass-card rounded-2xl hover-lift">
  <div class="flex items-center justify-between px-5 py-4 border-b border-white/5">
    <h2 class="text-sm font-semibold text-content font-display tracking-tight">Agent Status</h2>
    <% if @agent_in_session %>
      <span class="flex items-center gap-1.5 text-[11px] font-medium text-status-success">
        <span class="w-2 h-2 rounded-full bg-status-success animate-pulse"></span>
        In Session
      </span>
    <% elsif @agent_active %>
      <span class="flex items-center gap-1.5 text-[11px] font-medium text-status-success">
        <span class="w-2 h-2 rounded-full bg-status-success animate-pulse"></span>
        Online
      </span>
    <% else %>
      <span class="flex items-center gap-1.5 text-[11px] font-medium text-content-muted">
        <span class="w-2 h-2 rounded-full bg-content-muted/40"></span>
        Offline
      </span>
    <% end %>
  </div>

  <div class="p-5">
    <div class="flex items-center gap-3.5 mb-4">
      <%# Agent avatar %>
      <div class="w-11 h-11 rounded-xl bg-white/5 flex items-center justify-center">
        <span class="text-xl"><%= current_user.agent_emoji || "🦞" %></span>
      </div>
      <div>
        <p class="text-[13px] font-semibold text-content"><%= current_user.agent_name || "Agent" %></p>
        <% if current_user.agent_last_active_at.present? %>
          <p class="text-[11px] text-content-muted mt-0.5">Last active <%= time_ago_in_words(current_user.agent_last_active_at) %> ago</p>
        <% else %>
          <p class="text-[11px] text-content-muted mt-0.5">Never connected</p>
        <% end %>
      </div>
    </div>

    <%# Last activity — prefer agent_events, fall back to task_activities %>
    <% if @last_agent_event.present? %>
      <div class="bg-white/[0.03] rounded-xl p-3.5">
        <p class="text-[10px] text-content-muted mb-1.5 tracking-wide uppercase">Last event</p>
        <div class="flex items-center gap-2">
          <span class="text-[12px] font-medium
            <%= case @last_agent_event.event_type
                when 'task_completed' then 'text-green-400'
                when 'task_claimed' then 'text-blue-400'
                when 'error' then 'text-red-400'
                when 'tool_call' then 'text-purple-400'
                else 'text-content-secondary'
                end %>">
            <%= @last_agent_event.event_type.titleize %>
          </span>
          <span class="text-[12px] text-content-secondary truncate">
            <%= @last_agent_event.summary&.truncate(40) %>
          </span>
        </div>
        <p class="text-[10px] text-content-muted/50 mt-1.5"><%= time_ago_in_words(@last_agent_event.created_at) %> ago</p>
      </div>
    <% elsif @last_agent_activity.present? %>
      <div class="bg-white/[0.03] rounded-xl p-3.5">
        <p class="text-[10px] text-content-muted mb-1.5 tracking-wide uppercase">Last action</p>
        <div class="flex items-center gap-2">
          <% icon_class = case @last_agent_activity.action
            when "created" then "text-status-info"
            when "moved" then "text-purple-400"
            when "updated" then "text-status-warning"
            else "text-content-secondary"
          end %>
          <span class="text-[12px] <%= icon_class %> font-medium capitalize"><%= @last_agent_activity.action %></span>
          <span class="text-[12px] text-content-secondary truncate">
            <%= @last_agent_activity.task&.name&.truncate(40) %>
          </span>
        </div>
        <p class="text-[10px] text-content-muted/50 mt-1.5"><%= time_ago_in_words(@last_agent_activity.created_at) %> ago</p>
      </div>
    <% else %>
      <div class="bg-white/[0.03] rounded-xl p-3.5 text-center">
        <p class="text-[12px] text-content-muted">No agent activity recorded yet</p>
      </div>
    <% end %>
  </div>
</div>
