<% if @rules.any? %>
  <%# Group rules by category %>
  <% @rules.group_by(&:category).each do |category, rules| %>
    <div class="mb-6">
      <h3 class="text-xs font-semibold text-content-muted uppercase tracking-wider mb-3"><%= category.titleize %></h3>
      <div class="space-y-2">
        <% rules.each do |learning| %>
          <div id="<%= dom_id(learning) %>" class="glass-card rounded-2xl px-5 py-4">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs px-1.5 py-0.5 rounded font-medium
                    <%= case learning.severity
                        when 'critical' then 'bg-red-500/10 text-red-400'
                        when 'moderate' then 'bg-yellow-500/10 text-yellow-500'
                        else 'bg-white/5 text-content-muted'
                        end %>">
                    <%= learning.severity.capitalize %>
                  </span>
                  <span class="text-xs text-content-muted"><%= time_ago_in_words(learning.created_at) %> ago</span>
                </div>
                <h3 class="text-sm font-medium text-content tracking-tight"><%= learning.title %></h3>
                <% if learning.body.present? %>
                  <p class="text-xs text-content-secondary mt-1 line-clamp-2"><%= learning.body.truncate(200) %></p>
                <% end %>
                <% if learning.source_correction.present? %>
                  <p class="text-xs text-content-muted mt-1">
                    From: <span class="text-content-secondary"><%= learning.source_correction.title %></span>
                  </p>
                <% end %>
              </div>
              <div class="flex items-center gap-1 flex-shrink-0">
                <%= form_with url: learning_path(learning), method: :patch, class: "inline" do |f| %>
                  <input type="hidden" name="learning[status]" value="superseded">
                  <%= f.submit "Supersede",
                    class: "text-xs px-2.5 py-1.5 rounded-md bg-white/5 text-content-muted hover:bg-bg-hover transition-colors cursor-pointer" %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="text-center py-8">
    <div class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center mx-auto mb-3">
      <svg class="w-5 h-5 text-content-muted/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
      </svg>
    </div>
    <p class="text-sm font-medium text-content-muted">No failure rules yet</p>
    <p class="text-xs text-content-muted/50 mt-1">Rules are created from corrections — click "Create Rule" on a correction to start</p>
  </div>
<% end %>
