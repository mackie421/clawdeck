<% if @corrections.any? %>
  <div class="space-y-3">
    <% @corrections.each do |learning| %>
      <div id="<%= dom_id(learning) %>" class="bg-bg-surface border border-border rounded-lg p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2 flex-wrap">
              <span class="text-xs px-1.5 py-0.5 rounded font-medium
                <%= case learning.category
                    when 'tone' then 'bg-purple-500/10 text-purple-400'
                    when 'accuracy' then 'bg-blue-500/10 text-blue-400'
                    when 'tool_use' then 'bg-orange-500/10 text-orange-400'
                    when 'formatting' then 'bg-green-500/10 text-green-400'
                    when 'boundaries' then 'bg-red-500/10 text-red-400'
                    else 'bg-bg-elevated text-content-muted'
                    end %>">
                <%= learning.category.titleize %>
              </span>
              <span class="text-xs px-1.5 py-0.5 rounded font-medium
                <%= case learning.severity
                    when 'critical' then 'bg-red-500/10 text-red-400'
                    when 'moderate' then 'bg-yellow-500/10 text-yellow-500'
                    else 'bg-bg-elevated text-content-muted'
                    end %>">
                <%= learning.severity.capitalize %>
              </span>
              <% if learning.repeat_count > 0 %>
                <span class="text-xs px-1.5 py-0.5 rounded font-medium bg-accent/10 text-accent">
                  🔁 × <%= learning.repeat_count %>
                </span>
              <% end %>
            </div>
            <h3 class="text-sm font-medium text-content"><%= learning.title %></h3>
            <% if learning.body.present? %>
              <p class="text-xs text-content-secondary mt-1 line-clamp-3"><%= learning.body.truncate(300) %></p>
            <% end %>
            <div class="flex items-center gap-3 mt-2">
              <span class="text-xs text-content-muted"><%= time_ago_in_words(learning.created_at) %> ago</span>
              <% if learning.last_repeated_at.present? %>
                <span class="text-xs text-content-muted">Last repeated <%= time_ago_in_words(learning.last_repeated_at) %> ago</span>
              <% end %>
            </div>
          </div>
          <div class="flex items-center gap-1 flex-shrink-0">
            <% if learning.derived_rules.empty? %>
              <%= link_to "Create Rule", create_rule_learning_path(learning), data: { turbo_method: :post },
                class: "text-xs px-2.5 py-1.5 rounded-md bg-blue-500/10 text-blue-500 hover:bg-blue-500/20 transition-colors cursor-pointer" %>
            <% else %>
              <span class="text-xs px-2.5 py-1.5 text-green-500">Rule created</span>
            <% end %>
            <%= form_with url: learning_path(learning), method: :patch, class: "inline" do |f| %>
              <input type="hidden" name="learning[status]" value="superseded">
              <%= f.submit "Dismiss",
                class: "text-xs px-2.5 py-1.5 rounded-md bg-bg-elevated text-content-muted hover:bg-bg-hover transition-colors cursor-pointer" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12">
    <div class="w-10 h-10 rounded-lg bg-bg-elevated flex items-center justify-center mx-auto mb-3">
      <svg class="w-5 h-5 text-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    </div>
    <p class="text-sm text-content-muted">No corrections recorded</p>
    <p class="text-xs text-content-muted/60 mt-1">Corrections from the agent will appear here as they're submitted via the API</p>
  </div>
<% end %>
