<% if @proposals.any? %>
  <div class="space-y-3">
    <% @proposals.each do |learning| %>
      <div id="<%= dom_id(learning) %>" class="bg-bg-surface border border-border rounded-lg p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs px-1.5 py-0.5 rounded font-medium bg-yellow-500/10 text-yellow-500">Proposed</span>
              <span class="text-xs px-1.5 py-0.5 rounded font-medium
                <%= case learning.category
                    when 'tone' then 'bg-purple-500/10 text-purple-400'
                    when 'accuracy' then 'bg-blue-500/10 text-blue-400'
                    when 'tool_use' then 'bg-orange-500/10 text-orange-400'
                    when 'formatting' then 'bg-green-500/10 text-green-400'
                    when 'boundaries' then 'bg-red-500/10 text-red-400'
                    else 'bg-bg-elevated text-content-muted'
                    end %>">
                <%= learning.category.titleize %>
              </span>
              <span class="text-xs text-content-muted"><%= time_ago_in_words(learning.created_at) %> ago</span>
            </div>
            <h3 class="text-sm font-medium text-content"><%= learning.title %></h3>
            <% if learning.body.present? %>
              <p class="text-xs text-content-secondary mt-1 line-clamp-3"><%= learning.body.truncate(300) %></p>
            <% end %>
          </div>
          <div class="flex items-center gap-1 flex-shrink-0">
            <%= form_with url: learning_path(learning), method: :patch, class: "inline" do |f| %>
              <input type="hidden" name="learning[status]" value="approved">
              <%= f.submit "Approve",
                class: "text-xs px-2.5 py-1.5 rounded-md bg-green-500/10 text-green-500 hover:bg-green-500/20 transition-colors cursor-pointer" %>
            <% end %>
            <%= form_with url: learning_path(learning), method: :patch, class: "inline" do |f| %>
              <input type="hidden" name="learning[status]" value="rejected">
              <%= f.submit "Reject",
                class: "text-xs px-2.5 py-1.5 rounded-md bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-colors cursor-pointer" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12">
    <div class="w-10 h-10 rounded-lg bg-bg-elevated flex items-center justify-center mx-auto mb-3">
      <svg class="w-5 h-5 text-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
      </svg>
    </div>
    <p class="text-sm text-content-muted">No improvement proposals</p>
    <p class="text-xs text-content-muted/60 mt-1">The agent will propose skill and memory updates here for your review</p>
  </div>
<% end %>
