<% if @repeats.any? %>
  <div class="glass-card rounded-2xl overflow-hidden">
    <table class="w-full">
      <thead>
        <tr class="border-b border-white/5">
          <th class="text-left text-xs font-semibold text-content-muted uppercase tracking-wider px-5 py-4">Entry</th>
          <th class="text-left text-xs font-semibold text-content-muted uppercase tracking-wider px-5 py-4">Category</th>
          <th class="text-center text-xs font-semibold text-content-muted uppercase tracking-wider px-5 py-4">Repeats</th>
          <th class="text-left text-xs font-semibold text-content-muted uppercase tracking-wider px-5 py-4">Last Repeated</th>
          <th class="text-left text-xs font-semibold text-content-muted uppercase tracking-wider px-5 py-4">First Seen</th>
          <th class="text-right text-xs font-semibold text-content-muted uppercase tracking-wider px-5 py-4"></th>
        </tr>
      </thead>
      <tbody>
        <% @repeats.each do |learning| %>
          <tr class="border-b border-white/5 last:border-b-0 hover:bg-white/5 transition-colors">
            <td class="px-5 py-4">
              <p class="text-sm text-content font-medium truncate max-w-[250px]"><%= learning.title %></p>
            </td>
            <td class="px-5 py-4">
              <span class="text-xs px-1.5 py-0.5 rounded font-medium
                <%= case learning.category
                    when 'tone' then 'bg-purple-500/10 text-purple-400'
                    when 'accuracy' then 'bg-blue-500/10 text-blue-400'
                    when 'tool_use' then 'bg-orange-500/10 text-orange-400'
                    when 'formatting' then 'bg-green-500/10 text-green-400'
                    when 'boundaries' then 'bg-red-500/10 text-red-400'
                    else 'bg-white/5 text-content-muted'
                    end %>">
                <%= learning.category.titleize %>
              </span>
            </td>
            <td class="px-5 py-4 text-center">
              <span class="text-sm font-semibold text-accent"><%= learning.repeat_count %></span>
            </td>
            <td class="px-5 py-4">
              <span class="text-xs text-content-muted"><%= learning.last_repeated_at ? time_ago_in_words(learning.last_repeated_at) + " ago" : "—" %></span>
            </td>
            <td class="px-5 py-4">
              <span class="text-xs text-content-muted"><%= time_ago_in_words(learning.created_at) %> ago</span>
            </td>
            <td class="px-5 py-4 text-right">
              <% if learning.derived_rules.empty? %>
                <%= link_to "Create Rule", create_rule_learning_path(learning), data: { turbo_method: :post },
                  class: "text-xs px-2.5 py-1.5 rounded-md bg-blue-500/10 text-blue-500 hover:bg-blue-500/20 transition-colors" %>
              <% else %>
                <span class="text-xs text-green-500">Rule exists</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-8">
    <div class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center mx-auto mb-3">
      <svg class="w-5 h-5 text-content-muted/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 0 0-3.7-3.7 48.678 48.678 0 0 0-7.324 0 4.006 4.006 0 0 0-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 0 0 3.7 3.7 48.656 48.656 0 0 0 7.324 0 4.006 4.006 0 0 0 3.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3-3 3" />
      </svg>
    </div>
    <p class="text-sm font-medium text-content-muted">No recurring patterns detected</p>
    <p class="text-xs text-content-muted/50 mt-1">When the same type of correction recurs, it will be flagged here automatically</p>
  </div>
<% end %>
