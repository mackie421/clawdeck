<%# Shared learning card partial — used across all panels %>
<div id="<%= dom_id(learning) %>" class="glass-card rounded-2xl p-5">
  <div class="flex items-start justify-between gap-3">
    <div class="flex-1 min-w-0">
      <%# Badges row %>
      <div class="flex items-center gap-2 mb-2 flex-wrap">
        <%# Category badge %>
        <span class="text-xs px-1.5 py-0.5 rounded font-medium
          <%= case learning.category
              when 'tone' then 'bg-purple-500/10 text-purple-400'
              when 'accuracy' then 'bg-blue-500/10 text-blue-400'
              when 'tool_use' then 'bg-orange-500/10 text-orange-400'
              when 'formatting' then 'bg-green-500/10 text-green-400'
              when 'boundaries' then 'bg-red-500/10 text-red-400'
              else 'bg-white/5 text-content-muted'
              end %>">
          <%= learning.category.titleize %>
        </span>

        <%# Severity badge %>
        <span class="text-xs px-1.5 py-0.5 rounded font-medium
          <%= case learning.severity
              when 'critical' then 'bg-red-500/10 text-red-400'
              when 'moderate' then 'bg-yellow-500/10 text-yellow-500'
              else 'bg-white/5 text-content-muted'
              end %>">
          <%= learning.severity.capitalize %>
        </span>

        <%# Repeat indicator %>
        <% if learning.repeat_count > 0 %>
          <span class="text-xs px-1.5 py-0.5 rounded font-medium bg-accent/10 text-accent">
            🔁 × <%= learning.repeat_count %>
          </span>
        <% end %>
      </div>

      <%# Title %>
      <h3 class="text-sm font-medium text-content tracking-tight"><%= learning.title %></h3>

      <%# Body preview %>
      <% if learning.body.present? %>
        <p class="text-xs text-content-secondary mt-1 line-clamp-3"><%= learning.body.truncate(300) %></p>
      <% end %>

      <%# Source correction link %>
      <% if learning.source_correction.present? %>
        <p class="text-xs text-content-muted mt-2">
          From correction: <span class="text-content-secondary"><%= learning.source_correction.title %></span>
        </p>
      <% end %>

      <%# Meta info %>
      <div class="flex items-center gap-3 mt-2">
        <span class="text-xs text-content-muted"><%= time_ago_in_words(learning.created_at) %> ago</span>
        <% if learning.last_repeated_at.present? %>
          <span class="text-xs text-content-muted">Last repeated <%= time_ago_in_words(learning.last_repeated_at) %> ago</span>
        <% end %>
      </div>
    </div>

    <%# Action buttons — yielded by parent %>
    <% if local_assigns[:actions] %>
      <div class="flex items-center gap-1 flex-shrink-0">
        <%= actions %>
      </div>
    <% end %>
  </div>
</div>
