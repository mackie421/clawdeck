<%# Recent Errors from AgentEvents %>
<% if @recent_errors.any? %>
  <h3 class="text-sm font-medium text-content-secondary mb-3">Recent Errors (Last 10)</h3>
  <div class="space-y-2">
    <% @recent_errors.each do |event| %>
      <div class="bg-bg-surface border border-red-500/20 rounded-lg p-3">
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-red-500 mt-1.5 flex-shrink-0"></span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs px-1.5 py-0.5 rounded font-medium bg-red-500/10 text-red-400">
                <%= event.event_type.titleize %>
              </span>
              <% if event.session_id.present? %>
                <span class="text-xs text-content-muted">
                  Session: <%= event.session_id.truncate(12) %>
                </span>
              <% end %>
            </div>
            <% if event.summary.present? %>
              <p class="text-sm text-content"><%= event.summary %></p>
            <% end %>
            <% if event.details.present? && event.details.any? %>
              <p class="text-xs text-content-muted mt-1 font-mono">
                <%= event.details.to_json.truncate(200) %>
              </p>
            <% end %>
            <p class="text-xs text-content-muted/60 mt-1">
              <%= event.created_at.strftime("%b %d, %Y %l:%M %p") %>
            </p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12">
    <div class="w-10 h-10 rounded-lg bg-green-500/10 flex items-center justify-center mx-auto mb-3">
      <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    </div>
    <p class="text-sm text-content-muted">No recent errors</p>
    <p class="text-xs text-content-muted/60 mt-1">All systems running smoothly</p>
  </div>
<% end %>
