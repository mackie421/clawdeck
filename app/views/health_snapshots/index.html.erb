<% content_for :title, "System Health - clawdeck" %>
<% content_for :page_title, "System Health" %>

<div class="p-6" data-controller="health">
  <%# Tab navigation %>
  <div class="flex items-center gap-1 mb-6 border-b border-border">
    <button data-health-target="tab" data-action="click->health#switchTab"
            data-tab="status"
            class="px-3 py-2 text-sm font-medium border-b-2 transition-colors cursor-pointer border-accent text-content">
      Status
    </button>
    <button data-health-target="tab" data-action="click->health#switchTab"
            data-tab="resources"
            class="px-3 py-2 text-sm font-medium border-b-2 transition-colors cursor-pointer border-transparent text-content-muted hover:text-content-secondary">
      Resources
    </button>
    <button data-health-target="tab" data-action="click->health#switchTab"
            data-tab="errors"
            class="px-3 py-2 text-sm font-medium border-b-2 transition-colors cursor-pointer border-transparent text-content-muted hover:text-content-secondary">
      Errors
    </button>
  </div>

  <%# Status panel %>
  <div data-health-target="panel" data-panel="status">
    <%= render "health_snapshots/status_panel" %>
  </div>

  <%# Resources panel %>
  <div data-health-target="panel" data-panel="resources" class="hidden">
    <%= render "health_snapshots/resources_panel" %>
  </div>

  <%# Errors panel %>
  <div data-health-target="panel" data-panel="errors" class="hidden">
    <%= render "health_snapshots/errors_panel" %>
  </div>
</div>
