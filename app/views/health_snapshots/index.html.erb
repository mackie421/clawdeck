<% content_for :title, "System Health - clawdeck" %>
<% content_for :page_title, "System Health" %>

<div class="p-5 sm:p-8" data-controller="health">
  <%# Tab navigation %>
  <div class="flex items-center gap-0.5 mb-5 sm:mb-8 border-b border-white/5" role="tablist" aria-label="System Health">
    <button data-health-target="tab" data-action="click->health#switchTab keydown->health#keydown"
            data-tab="status"
            class="px-4 py-2.5 text-[13px] font-medium border-b-2 transition-colors duration-200 cursor-pointer border-accent text-content whitespace-nowrap">
      Status
    </button>
    <button data-health-target="tab" data-action="click->health#switchTab keydown->health#keydown"
            data-tab="resources"
            class="px-4 py-2.5 text-[13px] font-medium border-b-2 transition-colors duration-200 cursor-pointer border-transparent text-content-muted hover:text-content-secondary whitespace-nowrap">
      Resources
    </button>
    <button data-health-target="tab" data-action="click->health#switchTab keydown->health#keydown"
            data-tab="errors"
            class="px-4 py-2.5 text-[13px] font-medium border-b-2 transition-colors duration-200 cursor-pointer border-transparent text-content-muted hover:text-content-secondary whitespace-nowrap">
      Errors
    </button>
  </div>

  <%# Status panel %>
  <div data-health-target="panel" data-panel="status">
    <%= render "health_snapshots/status_panel" %>
  </div>

  <%# Resources panel %>
  <div data-health-target="panel" data-panel="resources" class="hidden">
    <%= render "health_snapshots/resources_panel" %>
  </div>

  <%# Errors panel %>
  <div data-health-target="panel" data-panel="errors" class="hidden">
    <%= render "health_snapshots/errors_panel" %>
  </div>
</div>
