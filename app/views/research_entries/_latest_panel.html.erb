<% if @latest.any? %>
  <div class="space-y-3">
    <% @latest.each do |entry| %>
      <%= render "research_entries/entry_card", entry: entry %>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12">
    <div class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center mx-auto mb-3">
      <svg class="w-5 h-5 text-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
    </div>
    <p class="text-sm font-medium text-content-muted">No research entries yet</p>
    <p class="text-xs text-content-muted/50 mt-1">Research from Larry Research and Last30Days will appear here</p>
  </div>
<% end %>
