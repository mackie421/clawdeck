<% content_for :title, "Cost Tracker - clawdeck" %>
<% content_for :page_title, "Cost Tracker" %>

<div class="p-4 sm:p-6" data-controller="costs">
  <%# Tab navigation %>
  <div class="flex items-center gap-1 mb-4 sm:mb-6 border-b border-border" role="tablist" aria-label="Cost Tracker">
    <button data-costs-target="tab" data-action="click->costs#switchTab keydown->costs#keydown"
            data-tab="spend"
            class="px-3 py-2 text-sm font-medium border-b-2 transition-colors cursor-pointer border-accent text-content whitespace-nowrap">
      Spend Overview
    </button>
    <button data-costs-target="tab" data-action="click->costs#switchTab keydown->costs#keydown"
            data-tab="history"
            class="px-3 py-2 text-sm font-medium border-b-2 transition-colors cursor-pointer border-transparent text-content-muted hover:text-content-secondary whitespace-nowrap">
      Daily History
    </button>
    <button data-costs-target="tab" data-action="click->costs#switchTab keydown->costs#keydown"
            data-tab="budget"
            class="px-3 py-2 text-sm font-medium border-b-2 transition-colors cursor-pointer border-transparent text-content-muted hover:text-content-secondary whitespace-nowrap">
      Budget
    </button>
  </div>

  <%# Spend Overview panel %>
  <div data-costs-target="panel" data-panel="spend">
    <%= render "cost_entries/spend_cards_panel" %>
  </div>

  <%# Daily History panel %>
  <div data-costs-target="panel" data-panel="history" class="hidden">
    <%= render "cost_entries/history_panel" %>
  </div>

  <%# Budget panel %>
  <div data-costs-target="panel" data-panel="budget" class="hidden">
    <%= render "cost_entries/budget_panel" %>
  </div>
</div>
