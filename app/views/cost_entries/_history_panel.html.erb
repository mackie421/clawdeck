<%# Daily History (last 30 days) %>
<% if @daily_history.any? %>
  <h3 class="text-sm font-medium text-content-secondary mb-3">Daily Spend (Last 30 Days)</h3>
  <div class="bg-bg-surface border border-border rounded-lg overflow-hidden mb-6">
    <table class="w-full">
      <thead>
        <tr class="border-b border-border">
          <th class="text-left text-xs font-medium text-content-muted uppercase tracking-wide px-4 py-2">Date</th>
          <th class="text-right text-xs font-medium text-content-muted uppercase tracking-wide px-4 py-2">API Calls</th>
          <th class="text-right text-xs font-medium text-content-muted uppercase tracking-wide px-4 py-2">Total Spend</th>
        </tr>
      </thead>
      <tbody>
        <% @daily_history.each do |day| %>
          <tr class="border-b border-border last:border-b-0 hover:bg-bg-elevated/50">
            <td class="px-4 py-2.5 text-sm text-content"><%= day[:date].strftime("%b %d, %Y") %></td>
            <td class="px-4 py-2.5 text-sm text-content-muted text-right"><%= day[:count] %></td>
            <td class="px-4 py-2.5 text-sm font-medium text-content text-right">$<%= sprintf("%.4f", day[:total]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Recent individual entries %>
  <h3 class="text-sm font-medium text-content-secondary mb-3">Recent Entries</h3>
  <div class="space-y-2">
    <% @recent_entries.each do |entry| %>
      <div class="bg-bg-surface border border-border rounded-lg p-3">
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs px-1.5 py-0.5 rounded font-medium bg-blue-500/10 text-blue-400">
                <%= entry.model_name %>
              </span>
              <span class="text-xs px-1.5 py-0.5 rounded font-medium bg-bg-elevated text-content-secondary">
                <%= entry.agent_id.titleize %>
              </span>
            </div>
            <p class="text-xs text-content-muted">
              <%= entry.input_tokens %> in / <%= entry.output_tokens %> out
              &middot; via <%= entry.provider %>
              <% if entry.session_id.present? %>
                &middot; session: <%= entry.session_id.truncate(12) %>
              <% end %>
            </p>
            <p class="text-xs text-content-muted/60 mt-0.5">
              <%= entry.created_at.strftime("%b %d, %Y %l:%M %p") %>
            </p>
          </div>
          <div class="flex-shrink-0 text-right">
            <p class="text-sm font-semibold text-content">$<%= sprintf("%.6f", entry.cost_usd.to_f) %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12">
    <div class="w-10 h-10 rounded-lg bg-bg-elevated flex items-center justify-center mx-auto mb-3">
      <svg class="w-5 h-5 text-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
      </svg>
    </div>
    <p class="text-sm text-content-muted">No daily history yet</p>
    <p class="text-xs text-content-muted/60 mt-1">Cost entries will populate the daily breakdown</p>
  </div>
<% end %>
