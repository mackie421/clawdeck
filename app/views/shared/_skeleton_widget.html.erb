<%# Loading skeleton for Turbo Frame widgets %>
<%# Usage: render "shared/skeleton_widget", lines: 3 %>
<% lines ||= 3 %>
<div class="glass-card rounded-2xl animate-shimmer">
  <div class="flex items-center justify-between px-5 py-4 border-b border-white/5">
    <div class="h-4 w-24 bg-white/5 rounded-md"></div>
    <div class="h-3 w-12 bg-white/5 rounded-md"></div>
  </div>
  <div class="p-5 flex flex-col gap-3.5">
    <% lines.times do |i| %>
      <div class="flex items-center gap-3">
        <div class="w-1.5 h-1.5 rounded-full bg-white/5 flex-shrink-0"></div>
        <div class="h-3 bg-white/5 rounded-md" style="width: <%= [85, 70, 60, 75, 55][i % 5] %>%"></div>
      </div>
    <% end %>
  </div>
</div>
