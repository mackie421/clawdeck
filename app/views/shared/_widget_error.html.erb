<%# Error boundary fallback for widgets that fail to render %>
<%# Usage: render "shared/widget_error", title: "Agenda" %>
<% title ||= "Widget" %>
<div class="bg-bg-surface border border-border rounded-lg">
  <div class="flex items-center justify-between px-4 py-3 border-b border-border">
    <h2 class="text-sm font-semibold text-content font-display"><%= title %></h2>
  </div>
  <div class="p-4">
    <div class="text-center py-6">
      <svg class="w-8 h-8 text-content-muted/40 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
      </svg>
      <p class="text-sm text-content-muted">Unable to load</p>
      <p class="text-xs text-content-muted/60 mt-1">This widget encountered an error. Try refreshing the page.</p>
    </div>
  </div>
</div>
