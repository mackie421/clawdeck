<% if @sessions.any? %>
  <div class="space-y-3">
    <% @sessions.each do |session_row| %>
      <% session_events = current_user.agent_events.for_session(session_row.session_id).order(created_at: :asc) %>
      <% first_event = session_events.first %>
      <% error_count = session_events.count { |e| e.severity_error? } %>

      <div class="bg-bg-surface border border-border rounded-lg overflow-hidden" data-controller="disclosure">
        <%# Session header — clickable to expand %>
        <button data-action="click->disclosure#toggle"
                class="w-full flex items-center gap-3 px-4 py-3 hover:bg-bg-elevated/30 transition-colors cursor-pointer">
          <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-bg-elevated flex items-center justify-center text-sm">
            <%= first_event&.agent_emoji || "🤖" %>
          </div>
          <div class="flex-1 min-w-0 text-left">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-content"><%= first_event&.agent_name || "Agent Session" %></span>
              <span class="text-xs text-content-muted"><%= session_row.event_count %> events</span>
              <% if error_count > 0 %>
                <span class="text-xs px-1.5 py-0.5 rounded font-medium bg-red-500/10 text-red-400"><%= error_count %> error<%= error_count > 1 ? "s" : "" %></span>
              <% end %>
            </div>
            <div class="flex items-center gap-3 mt-0.5">
              <span class="text-xs text-content-muted"><%= session_row.started_at.strftime("%b %-d, %-I:%M%P") %></span>
              <% duration_mins = ((session_row.ended_at - session_row.started_at) / 60).round %>
              <span class="text-xs text-content-muted">~<%= duration_mins %> min</span>
            </div>
          </div>
          <svg data-disclosure-target="icon" class="w-4 h-4 text-content-muted transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        </button>

        <%# Collapsible event list %>
        <div data-disclosure-target="content" class="hidden border-t border-border">
          <% session_events.each do |event| %>
            <%= render "agent_events/event_item", event: event %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12">
    <div class="w-10 h-10 rounded-lg bg-bg-elevated flex items-center justify-center mx-auto mb-3">
      <svg class="w-5 h-5 text-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z" />
      </svg>
    </div>
    <p class="text-sm text-content-muted">No sessions recorded</p>
    <p class="text-xs text-content-muted/60 mt-1">Agent sessions will appear here grouped by session ID</p>
  </div>
<% end %>
