<% if @error_events.any? %>
  <div class="bg-bg-surface border border-border rounded-lg overflow-hidden">
    <table class="w-full">
      <thead>
        <tr class="border-b border-border">
          <th class="text-left text-xs font-semibold text-content-muted uppercase tracking-wider px-4 py-3">Timestamp</th>
          <th class="text-left text-xs font-semibold text-content-muted uppercase tracking-wider px-4 py-3">Agent</th>
          <th class="text-left text-xs font-semibold text-content-muted uppercase tracking-wider px-4 py-3">Summary</th>
          <th class="text-left text-xs font-semibold text-content-muted uppercase tracking-wider px-4 py-3">Details</th>
        </tr>
      </thead>
      <tbody>
        <% @error_events.each do |event| %>
          <tr class="border-b border-border last:border-b-0 hover:bg-bg-elevated/30 transition-colors">
            <td class="px-4 py-3 whitespace-nowrap">
              <span class="text-xs text-content-muted"><%= event.created_at.strftime("%b %-d, %-I:%M%P") %></span>
            </td>
            <td class="px-4 py-3 whitespace-nowrap">
              <div class="flex items-center gap-1.5">
                <span class="text-sm"><%= event.agent_emoji || "🤖" %></span>
                <span class="text-xs text-content-secondary"><%= event.agent_name || "Agent" %></span>
              </div>
            </td>
            <td class="px-4 py-3">
              <p class="text-sm text-content truncate max-w-[300px]"><%= event.summary %></p>
            </td>
            <td class="px-4 py-3">
              <% if event.details.present? && event.details.any? %>
                <details class="group">
                  <summary class="text-xs text-accent cursor-pointer hover:text-accent-hover">View details</summary>
                  <pre class="mt-2 text-xs text-content-secondary bg-bg-elevated rounded p-2 max-w-[300px] overflow-x-auto"><%= JSON.pretty_generate(event.details) %></pre>
                </details>
              <% else %>
                <span class="text-xs text-content-muted">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-12">
    <div class="w-10 h-10 rounded-lg bg-bg-elevated flex items-center justify-center mx-auto mb-3">
      <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    </div>
    <p class="text-sm text-content-muted">No errors recorded</p>
    <p class="text-xs text-content-muted/60 mt-1">All clear — agent error events will appear here if any occur</p>
  </div>
<% end %>
