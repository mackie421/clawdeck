<% if @error_events.any? %>
  <div class="glass-card rounded-2xl overflow-hidden">
    <table class="w-full">
      <thead>
        <tr class="border-b border-white/5">
          <th class="text-left text-xs font-semibold text-content-muted uppercase tracking-wider px-5 py-4">Timestamp</th>
          <th class="text-left text-xs font-semibold text-content-muted uppercase tracking-wider px-5 py-4">Agent</th>
          <th class="text-left text-xs font-semibold text-content-muted uppercase tracking-wider px-5 py-4">Summary</th>
          <th class="text-left text-xs font-semibold text-content-muted uppercase tracking-wider px-5 py-4">Details</th>
        </tr>
      </thead>
      <tbody>
        <% @error_events.each do |event| %>
          <tr class="border-b border-white/5 last:border-b-0 hover:bg-white/[0.03] transition-colors">
            <td class="px-5 py-4 whitespace-nowrap">
              <span class="text-xs text-content-muted"><%= event.created_at.strftime("%b %-d, %-I:%M%P") %></span>
            </td>
            <td class="px-5 py-4 whitespace-nowrap">
              <div class="flex items-center gap-1.5">
                <span class="text-sm"><%= event.agent_emoji || "🤖" %></span>
                <span class="text-xs text-content-secondary"><%= event.agent_name || "Agent" %></span>
              </div>
            </td>
            <td class="px-5 py-4">
              <p class="text-sm text-content truncate max-w-[300px]"><%= event.summary %></p>
            </td>
            <td class="px-5 py-4">
              <% if event.details.present? && event.details.any? %>
                <details class="group">
                  <summary class="text-xs text-accent cursor-pointer hover:text-accent-hover">View details</summary>
                  <pre class="mt-2 text-xs text-content-secondary bg-white/5 rounded p-2 max-w-[300px] overflow-x-auto"><%= JSON.pretty_generate(event.details) %></pre>
                </details>
              <% else %>
                <span class="text-xs text-content-muted">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-8">
    <div class="w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center mx-auto mb-3">
      <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    </div>
    <p class="text-sm font-medium text-content-muted">No errors recorded</p>
    <p class="text-xs text-content-muted/50 mt-1">All clear — agent error events will appear here if any occur</p>
  </div>
<% end %>
