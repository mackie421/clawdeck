<div class="glass-card rounded-2xl overflow-hidden">
  <div id="live-feed">
    <% if @feed_events.any? %>
      <% @feed_events.each do |event| %>
        <%= render "agent_events/event_item", event: event %>
      <% end %>
    <% else %>
      <div class="text-center py-8">
        <div class="w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center mx-auto mb-3">
          <svg class="w-5 h-5 text-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.348 14.652a3.75 3.75 0 0 1 0-5.304m5.304 0a3.75 3.75 0 0 1 0 5.304m-7.425 2.121a6.75 6.75 0 0 1 0-9.546m9.546 0a6.75 6.75 0 0 1 0 9.546M5.106 18.894c-3.808-3.807-3.808-9.98 0-13.788m13.788 0c3.808 3.807 3.808 9.98 0 13.788M12 12h.008v.008H12V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
          </svg>
        </div>
        <p class="text-sm font-medium text-content-muted">No events yet</p>
        <p class="text-xs text-content-muted/50 mt-1">Agent activity will stream here in real-time as events are posted via the API</p>
      </div>
    <% end %>
  </div>
</div>
