<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "clawdeck" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="ClawDeck">
    <meta name="application-name" content="ClawDeck">
    <meta name="mobile-web-app-capable" content="yes">
    <%# Theme colors for Safari and other browsers %>
    <meta name="theme-color" content="#050810">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Fonts - Clash Display + Satoshi %>
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@700,600,500&f[]=satoshi@400,500,700&display=swap" rel="stylesheet">
    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <%# Favicons %>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "application/plausible_analytics" %>
  </head>
  <body class="h-screen overflow-hidden bg-bg-base font-body" data-controller="turbo-progress">
    <% if @board_page %>
      <%# Board page - sidebar on desktop, full screen on mobile %>
      <div class="h-screen flex flex-col bg-bg-base" data-controller="sidebar">
        <% if authenticated? %>
          <div class="hidden md:block">
            <%= render "application/sidebar" %>
          </div>
        <% end %>
        <div data-sidebar-target="content" class="flex-1 flex flex-col min-h-0 transition-[margin] duration-200 ease-out">
          <main class="h-full text-content-secondary font-normal text-sm">
            <%= yield %>
          </main>
        </div>
      </div>
    <% elsif @dashboard_page %>
      <%# Dashboard/mission control pages - sidebar + full-width content %>
      <div class="h-screen flex flex-col bg-bg-base" data-controller="sidebar">
        <% if authenticated? %>
          <%= render "application/sidebar" %>
          <%# Mobile overlay for sidebar %>
          <div data-sidebar-target="overlay"
               data-action="click->sidebar#close"
               class="hidden fixed inset-0 z-30 bg-black/50 md:hidden"></div>
        <% end %>
        <div data-sidebar-target="content" class="flex-1 flex flex-col min-h-0 transition-[margin] duration-200 ease-out">
          <%# Dashboard header bar %>
          <header class="flex-shrink-0 flex items-center justify-between px-4 sm:px-6 py-3 bg-bg-base border-b border-border">
            <div class="flex items-center gap-3">
              <%# Mobile hamburger — opens sidebar %>
              <button data-action="click->sidebar#toggle"
                      class="md:hidden flex items-center justify-center w-8 h-8 -ml-1 rounded-md hover:bg-bg-elevated transition-colors cursor-pointer"
                      aria-label="Open menu">
                <svg class="w-5 h-5 text-content-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
              </button>
              <h1 class="text-lg font-semibold text-content font-display"><%= yield(:page_title).presence || "Dashboard" %></h1>
            </div>
            <div class="flex items-center gap-2">
              <%# Agent indicator %>
              <% if authenticated? && current_user.agent_last_active_at.present? %>
                <div class="relative cursor-default" title="<%= current_user.agent_name || 'Agent' %> • Last active: <%= time_ago_in_words(current_user.agent_last_active_at) %> ago">
                  <span class="text-lg"><%= current_user.agent_emoji || "🦞" %></span>
                  <% if current_user.agent_last_active_at > 5.minutes.ago %>
                    <span class="absolute -bottom-0.5 -right-0.5 w-2 h-2 bg-green-500 rounded-full border border-bg-base"></span>
                  <% end %>
                </div>
              <% end %>
              <%# User avatar %>
              <% if authenticated? %>
                <div class="relative" data-controller="dropdown">
                  <button type="button" data-dropdown-target="button" data-action="click->dropdown#toggle"
                          class="flex items-center cursor-pointer" aria-expanded="false" aria-haspopup="true">
                    <div class="w-7 h-7 rounded-md overflow-hidden bg-bg-surface flex items-center justify-center">
                      <% if current_user.has_avatar? %>
                        <%= image_tag current_user.avatar_source, class: "w-full h-full object-cover", alt: "Your avatar" %>
                      <% else %>
                        <svg class="w-4 h-4 text-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                      <% end %>
                    </div>
                  </button>
                  <div data-dropdown-target="menu"
                       class="hidden absolute right-0 top-full mt-1 w-48 bg-bg-surface rounded-lg shadow-lg border border-border overflow-hidden z-50">
                    <div class="px-3 py-2.5 bg-bg-elevated border-b border-border">
                      <p class="text-xs font-medium text-content truncate"><%= current_user.email_address.split('@').first %></p>
                      <p class="text-xs text-content-muted truncate"><%= current_user.email_address %></p>
                    </div>
                    <div class="py-1">
                      <%= link_to settings_path, class: "flex items-center gap-2 px-3 py-2 text-xs text-content-secondary hover:bg-bg-elevated transition-colors" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        Settings
                      <% end %>
                      <div class="border-t border-border my-1"></div>
                      <%= link_to session_path, method: :delete, data: { turbo_method: :delete }, class: "flex items-center gap-2 px-3 py-2 text-xs text-accent hover:bg-bg-elevated transition-colors" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                        Sign out
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </header>
          <%# Page content %>
          <div class="flex-1 overflow-y-auto overscroll-contain [-webkit-overflow-scrolling:touch]">
            <main class="text-content-secondary font-normal text-sm">
              <%= yield %>
            </main>
          </div>
        </div>
      </div>
    <% else %>
      <%# Other pages (settings, etc.) - centered content with navbar %>
      <div class="h-screen flex flex-col bg-bg-base">
        <%= render "application/navbar" %>
        <div class="flex-1 overflow-y-auto px-4 pb-8 overscroll-contain [-webkit-overflow-scrolling:touch]">
          <main class="container max-w-lg mx-auto text-content-secondary font-normal text-sm">
            <%= yield %>
          </main>
        </div>
      </div>
    <% end %>
  </body>
</html>
