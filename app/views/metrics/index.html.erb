<% content_for :title, "Analytics - clawdeck" %>
<% content_for :page_title, "Analytics" %>

<div class="p-5 sm:p-8" data-controller="analytics">
  <%# Tab navigation %>
  <div class="flex items-center gap-0.5 mb-5 sm:mb-8 border-b border-white/5" role="tablist" aria-label="Analytics">
    <button data-analytics-target="tab" data-action="click->analytics#switchTab keydown->analytics#keydown"
            data-tab="overview"
            class="px-4 py-2.5 text-[13px] font-medium border-b-2 transition-colors duration-200 cursor-pointer border-accent text-content">
      Overview
    </button>
    <button data-analytics-target="tab" data-action="click->analytics#switchTab keydown->analytics#keydown"
            data-tab="charts"
            class="px-4 py-2.5 text-[13px] font-medium border-b-2 transition-colors duration-200 cursor-pointer border-transparent text-content-muted hover:text-content-secondary">
      Charts
    </button>
    <button data-analytics-target="tab" data-action="click->analytics#switchTab keydown->analytics#keydown"
            data-tab="reports"
            class="px-4 py-2.5 text-[13px] font-medium border-b-2 transition-colors duration-200 cursor-pointer border-transparent text-content-muted hover:text-content-secondary">
      Reports
    </button>
  </div>

  <%# Overview panel %>
  <div data-analytics-target="panel" data-panel="overview">
    <%= render "metrics/overview_panel" %>
  </div>

  <%# Charts panel %>
  <div data-analytics-target="panel" data-panel="charts" class="hidden">
    <%= render "metrics/charts_panel" %>
  </div>

  <%# Reports panel %>
  <div data-analytics-target="panel" data-panel="reports" class="hidden">
    <%= render "metrics/reports_panel" %>
  </div>
</div>
