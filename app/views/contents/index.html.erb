<% content_for :title, "Content Studio - clawdeck" %>
<% content_for :page_title, "Content Studio" %>

<div class="p-4 sm:p-6" data-controller="content-studio">
  <%# Tab navigation %>
  <div class="flex items-center gap-1 mb-4 sm:mb-6 border-b border-border overflow-x-auto" role="tablist" aria-label="Content Studio">
    <button data-content-studio-target="tab" data-action="click->content-studio#switchTab keydown->content-studio#keydown"
            data-tab="drafts"
            class="px-3 py-2 text-sm font-medium border-b-2 transition-colors cursor-pointer border-accent text-content whitespace-nowrap">
      Drafts
      <% if @drafts.any? %>
        <span class="ml-1 text-xs bg-bg-elevated text-content-secondary px-1.5 py-0.5 rounded-full"><%= @drafts.size %></span>
      <% end %>
    </button>
    <button data-content-studio-target="tab" data-action="click->content-studio#switchTab keydown->content-studio#keydown"
            data-tab="ideas"
            class="px-3 py-2 text-sm font-medium border-b-2 transition-colors cursor-pointer border-transparent text-content-muted hover:text-content-secondary whitespace-nowrap">
      Ideas
      <% if @ideas.any? %>
        <span class="ml-1 text-xs bg-bg-elevated text-content-secondary px-1.5 py-0.5 rounded-full"><%= @ideas.size %></span>
      <% end %>
    </button>
    <button data-content-studio-target="tab" data-action="click->content-studio#switchTab keydown->content-studio#keydown"
            data-tab="calendar"
            class="px-3 py-2 text-sm font-medium border-b-2 transition-colors cursor-pointer border-transparent text-content-muted hover:text-content-secondary whitespace-nowrap">
      Calendar
    </button>
  </div>

  <%# Drafts panel %>
  <div data-content-studio-target="panel" data-panel="drafts">
    <%= render "contents/drafts_panel" %>
  </div>

  <%# Ideas panel %>
  <div data-content-studio-target="panel" data-panel="ideas" class="hidden">
    <%= render "contents/ideas_panel" %>
  </div>

  <%# Calendar panel %>
  <div data-content-studio-target="panel" data-panel="calendar" class="hidden">
    <%= render "contents/calendar_panel" %>
  </div>
</div>
