<% content_for :title, "Content Studio - clawdeck" %>
<% content_for :page_title, "Content Studio" %>

<div class="p-5 sm:p-8" data-controller="content-studio">
  <%# Tab navigation %>
  <div class="flex items-center gap-0.5 mb-5 sm:mb-8 border-b border-white/5 overflow-x-auto" role="tablist" aria-label="Content Studio">
    <button data-content-studio-target="tab" data-action="click->content-studio#switchTab keydown->content-studio#keydown"
            data-tab="drafts"
            class="px-4 py-2.5 text-[13px] font-medium border-b-2 transition-colors duration-200 cursor-pointer border-accent text-content whitespace-nowrap">
      Drafts
      <% if @drafts.any? %>
        <span class="ml-1.5 text-[10px] bg-white/5 text-content-secondary px-1.5 py-0.5 rounded-full"><%= @drafts.size %></span>
      <% end %>
    </button>
    <button data-content-studio-target="tab" data-action="click->content-studio#switchTab keydown->content-studio#keydown"
            data-tab="ideas"
            class="px-4 py-2.5 text-[13px] font-medium border-b-2 transition-colors duration-200 cursor-pointer border-transparent text-content-muted hover:text-content-secondary whitespace-nowrap">
      Ideas
      <% if @ideas.any? %>
        <span class="ml-1.5 text-[10px] bg-white/5 text-content-secondary px-1.5 py-0.5 rounded-full"><%= @ideas.size %></span>
      <% end %>
    </button>
    <button data-content-studio-target="tab" data-action="click->content-studio#switchTab keydown->content-studio#keydown"
            data-tab="calendar"
            class="px-4 py-2.5 text-[13px] font-medium border-b-2 transition-colors duration-200 cursor-pointer border-transparent text-content-muted hover:text-content-secondary whitespace-nowrap">
      Calendar
    </button>
  </div>

  <%# Drafts panel %>
  <div data-content-studio-target="panel" data-panel="drafts">
    <%= render "contents/drafts_panel" %>
  </div>

  <%# Ideas panel %>
  <div data-content-studio-target="panel" data-panel="ideas" class="hidden">
    <%= render "contents/ideas_panel" %>
  </div>

  <%# Calendar panel %>
  <div data-content-studio-target="panel" data-panel="calendar" class="hidden">
    <%= render "contents/calendar_panel" %>
  </div>
</div>
