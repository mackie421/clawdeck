<% if @drafts.any? %>
  <div class="space-y-3">
    <% @drafts.each do |content| %>
      <%= render "contents/draft_card", content: content %>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12">
    <div class="w-10 h-10 rounded-lg bg-bg-elevated flex items-center justify-center mx-auto mb-3">
      <svg class="w-5 h-5 text-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
      </svg>
    </div>
    <p class="text-sm text-content-muted">No drafts yet</p>
    <p class="text-xs text-content-muted/60 mt-1">Drafts from Larry Content will appear here for review</p>
  </div>
<% end %>
