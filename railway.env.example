RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=1
DB_POOL=10
# Optional: enable only after Solid Queue tables exist
# SOLID_QUEUE_IN_PUMA=1

# Required
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
DATABASE_URL=

# Domain/host settings
APP_HOST=
# Optional: comma-separated additional hosts, e.g. .up.railway.app
ALLOWED_HOSTS=

# Optional GitHub OAuth login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
